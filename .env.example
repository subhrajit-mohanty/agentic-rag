# ============================================
# Enterprise Agentic RAG Platform Configuration
# ============================================

# Application Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production

# ============================================
# OpenAI Configuration (DEFAULT LLM & EMBEDDINGS)
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM Settings
LLM_PROVIDER=openai
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Embedding Settings
VECTOR_EMBEDDING_PROVIDER=openai
VECTOR_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_OPENAI_EMBEDDING_DIMENSION=1536

# ============================================
# Alternative: Ollama (Local LLM)
# ============================================
# Uncomment below to use Ollama instead of OpenAI
# LLM_PROVIDER=ollama
# LLM_OLLAMA_HOST=http://localhost:11434
# LLM_OLLAMA_MODEL=llama3.2:3b
# VECTOR_EMBEDDING_PROVIDER=sentence_transformers
# VECTOR_SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ============================================
# MongoDB Configuration
# ============================================
MONGO_USERNAME=raguser
MONGO_PASSWORD=ragpassword
MONGO_DATABASE=enterprise_rag
MONGO_URI=mongodb://raguser:ragpassword@localhost:27017/enterprise_rag?authSource=admin

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=3600

# ============================================
# Agent Configuration
# ============================================
AGENT_MAX_RETRIEVAL_ATTEMPTS=2
AGENT_GUARDRAIL_THRESHOLD=60
AGENT_TOP_K_RESULTS=5
AGENT_USE_HYBRID_SEARCH=true

# ============================================
# CORS & Security
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
